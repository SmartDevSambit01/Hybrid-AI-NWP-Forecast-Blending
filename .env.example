# ============================================================
# Environment Configuration — Hybrid AI–NWP Blending System
# Ministry of Earth Sciences (MoES) / NCMRWF Prototype
# ============================================================
# Copy this file to .env and set actual values when live operational
# streams become available. NEVER commit .env with real keys.

# ---- Application Mode ----
APP_ENV=development
# Set to 'live_operational' when live NCMRWF data streams are connected
DATA_MODE=demo_replay

# ---- NCMRWF Operational Data (Requires Authorized Access) ----
# Leave blank until official NCMRWF data stream authorization is obtained.
NCMRWF_NCUM_URL=
NCMRWF_NEPS_URL=
NCMRWF_API_KEY=

# ---- AI Weather Model Inference API ----
# Leave blank until inference endpoint access is configured.
AI_MODEL_URL=
AI_MODEL_API_KEY=

# ---- Observation Network Provider ----
# Leave blank until observation data provider is configured.
OBS_PROVIDER_URL=
